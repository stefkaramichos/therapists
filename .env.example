# Domain must point to your server's public IP; do not include https://
DOMAIN=asr.example.com
AUTH_USER=therapist
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'YOUR_LONG_UNIQUE_PASSWORD'
# Place the resulting hash below; never put the plaintext password here.
AUTH_HASH=REPLACE_WITH_CADDY_HASH
ASR_MODEL=large-v3
ASR_THREADS=4
